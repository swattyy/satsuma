<Window x:Class="Satsuma.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Satsuma Settings" Width="600" Height="780" MinWidth="480" MinHeight="420"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,22,28,28">

            <!-- Header -->
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image x:Name="Logo" Width="48" Height="48" Margin="0,0,14,0" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Satsuma" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Text="Drag a file, tap a key, drop on what you want." Style="{StaticResource Hint}" />
                </StackPanel>
                <CheckBox x:Name="EnabledSwitch" Grid.Column="2" Style="{StaticResource Switch}" VerticalAlignment="Center" Content="Active" />
            </Grid>

            <TextBlock Text="Wheel keys" Style="{StaticResource Section}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="170" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Convert" FontWeight="SemiBold" />
                            <TextBlock Text="Change the file to another format" Style="{StaticResource Hint}" />
                        </StackPanel>
                        <ComboBox x:Name="ConvertKey" Grid.Column="1" VerticalAlignment="Center" />
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="170" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Tools" FontWeight="SemiBold" />
                            <TextBlock Text="Compress, resize, crop, trim, merge…" Style="{StaticResource Hint}" />
                        </StackPanel>
                        <ComboBox x:Name="ToolsKey" Grid.Column="1" VerticalAlignment="Center" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="170" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Actions" FontWeight="SemiBold" />
                            <TextBlock Text="Share, shelf, copy, move, copy path, terminal" Style="{StaticResource Hint}" />
                        </StackPanel>
                        <ComboBox x:Name="ActionsKey" Grid.Column="1" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Margin="0,12,0,0" Style="{StaticResource Hint}"
                               Text="Start dragging a file, then tap the key. The wheel stays open until you drop; tap another key to switch wheels, or the same key to close it." />
                </StackPanel>
            </Border>

            <TextBlock Text="Saving" Style="{StaticResource Section}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <RadioButton x:Name="OutNext" Content="Next to the original file" GroupName="Out" Margin="0,0,0,6" />
                    <RadioButton x:Name="OutDownloads" Content="Downloads folder" GroupName="Out" Margin="0,0,0,6" />
                    <DockPanel>
                        <Button x:Name="BrowseFolder" Content="Choose…" DockPanel.Dock="Right" Padding="12,4" />
                        <RadioButton x:Name="OutCustom" GroupName="Out" VerticalAlignment="Center">
                            <TextBlock x:Name="CustomFolderText" Text="A folder of my choice" TextTrimming="CharacterEllipsis" />
                        </RadioButton>
                    </DockPanel>
                    <CheckBox x:Name="RevealSwitch" Style="{StaticResource Switch}" Margin="0,14,0,0" Content="Show the result in Explorer after converting" />
                </StackPanel>
            </Border>

            <TextBlock Text="Quality" Style="{StaticResource Section}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock x:Name="QualityText" DockPanel.Dock="Right" FontWeight="SemiBold" Width="40" TextAlignment="Right" />
                        <TextBlock Text="JPEG / WebP / HEIC / AVIF quality" />
                    </DockPanel>
                    <Slider x:Name="QualitySlider" Minimum="40" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" />
                    <CheckBox x:Name="MetadataSwitch" Style="{StaticResource Switch}" Margin="0,12,0,0" Content="Keep photo metadata (date, camera, location) when converting" />
                    <CheckBox x:Name="GpuSwitch" Style="{StaticResource Switch}" Margin="0,12,0,0" Content="Use the graphics card for video (NVIDIA NVENC)" />
                    <DockPanel Margin="0,12,0,0">
                        <ComboBox x:Name="DpiCombo" DockPanel.Dock="Right" Width="120" />
                        <TextBlock Text="PDF page images" VerticalAlignment="Center" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="Look &amp; feel" Style="{StaticResource Section}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <CheckBox x:Name="StartupSwitch" Style="{StaticResource Switch}" Content="Start Satsuma when I sign in" />
                    <CheckBox x:Name="HintsSwitch" Style="{StaticResource Switch}" Margin="0,12,0,0" Content="Show key hints under the wheel" />
                    <CheckBox x:Name="SoundSwitch" Style="{StaticResource Switch}" Margin="0,12,0,0" Content="Play subtle sounds" />
                    <DockPanel Margin="0,12,0,0">
                        <ComboBox x:Name="ThemeCombo" DockPanel.Dock="Right" Width="120" />
                        <TextBlock Text="Wheel theme" VerticalAlignment="Center" />
                    </DockPanel>
                    <DockPanel Margin="0,12,0,4">
                        <TextBlock x:Name="ScaleText" DockPanel.Dock="Right" FontWeight="SemiBold" Width="48" TextAlignment="Right" />
                        <TextBlock Text="Wheel size" />
                    </DockPanel>
                    <Slider x:Name="ScaleSlider" Minimum="0.7" Maximum="1.4" TickFrequency="0.05" IsSnapToTickEnabled="True" />
                </StackPanel>
            </Border>

            <TextBlock Text="Engines" Style="{StaticResource Section}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel>
                        <Button x:Name="InstallFfmpeg" Content="Install" DockPanel.Dock="Right" Padding="14,4" VerticalAlignment="Center" />
                        <StackPanel>
                            <TextBlock Text="FFmpeg (audio and video)" FontWeight="SemiBold" />
                            <TextBlock x:Name="FfmpegStatus" Style="{StaticResource Hint}" />
                        </StackPanel>
                    </DockPanel>
                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="Microsoft Office (documents)" FontWeight="SemiBold" />
                        <TextBlock x:Name="OfficeStatus" Style="{StaticResource Hint}" />
                    </StackPanel>
                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="Windows imaging" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Hint}" Text="HEIC, AVIF, WebP and camera RAW use Windows' own codecs (HEIF / AV1 / Raw Image Extensions in the Microsoft Store)." />
                    </StackPanel>
                </StackPanel>
            </Border>

            <DockPanel Margin="2,10,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="TourButton" Content="How it works" Padding="12,4" Margin="0,0,8,0" />
                    <Button x:Name="LogButton" Content="Open log" Padding="12,4" />
                </StackPanel>
                <TextBlock x:Name="VersionText" Style="{StaticResource Hint}" VerticalAlignment="Center"
                           Text="Everything runs on this PC. Nothing is uploaded." />
            </DockPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
