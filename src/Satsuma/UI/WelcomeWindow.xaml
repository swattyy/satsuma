<Window x:Class="Satsuma.UI.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to Satsuma" Width="680" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <StackPanel Margin="36,30,36,28">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
            <Image x:Name="Logo" Width="44" Height="44" Margin="0,0,14,0" />
            <TextBlock Text="Drag. Tap. Drop." FontSize="30" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Style="{StaticResource Hint}" FontSize="14" Margin="0,4,0,22"
                   Text="Convert files while you're dragging them. There's no app to open and nothing gets uploaded; it all runs on this PC." />

        <UniformGrid Columns="3" Margin="0,0,0,22">
            <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="1" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Tangerine}" />
                    <TextBlock Text="Start dragging" FontWeight="SemiBold" Margin="0,4,0,2" />
                    <TextBlock Style="{StaticResource Hint}" Text="Any file or folder, from Explorer, the desktop or a browser." />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="4,0,4,0">
                <StackPanel>
                    <TextBlock Text="2" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Tangerine}" />
                    <TextBlock Text="Tap a key" FontWeight="SemiBold" Margin="0,4,0,6" />
                    <StackPanel x:Name="KeyList" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="3" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Tangerine}" />
                    <TextBlock Text="Drop on it" FontWeight="SemiBold" Margin="0,4,0,2" />
                    <TextBlock Style="{StaticResource Hint}" Text="Release over a format or tool. The new file appears next to the original." />
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border x:Name="Practice" CornerRadius="12" BorderThickness="1.5" Padding="18" Margin="0,0,0,24"
                BorderBrush="{StaticResource Tangerine}" Background="Transparent" Cursor="Hand">
            <DockPanel>
                <Border x:Name="Tile" Width="76" Height="76" CornerRadius="10" Margin="0,0,18,0" ClipToBounds="True"
                        BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                    <Image x:Name="SampleThumb" Stretch="UniformToFill" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Try it now" FontWeight="SemiBold" FontSize="15" />
                    <TextBlock x:Name="PracticeText" Style="{StaticResource Hint}" FontSize="13" Margin="0,3,0,0"
                               Text="Drag this picture a little, tap Shift, then drop it on WEBP." />
                </StackPanel>
            </DockPanel>
        </Border>

        <DockPanel>
            <Button x:Name="Done" Content="Get started" Style="{StaticResource SatsumaAccentButton}" DockPanel.Dock="Right" />
            <CheckBox x:Name="StartupSwitch" Style="{StaticResource Switch}" VerticalAlignment="Center" HorizontalAlignment="Left"
                      Content="Start Satsuma when I sign in" IsChecked="True" />
        </DockPanel>
    </StackPanel>
</Window>
